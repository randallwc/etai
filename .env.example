AMBIG_API=<key>
AMBIGUOUS_API_KEY=<key>
COPILOT_API=<key>
AMBIGUOUS_BASE_URL=https://app.ambiguous.ai
AMBIG_WEBHOOK_SECRET=<secret>

# phone numbers, E.164
CONTRACT_PHONE=<e.g. +15551234567>
CLIENT_PHONE=<E.164>
CONTRACTOR_TZ=America/Los_Angeles

# wiring -- without BOTH of these the bus never receives texts:
# it self-subscribes PUBLIC_URL/webhooks/inbound at MESSAGING_URL.
MESSAGING_URL=http://localhost:4020
PUBLIC_URL=http://localhost:4010
# messaging: seed a subscriber instead of relying on self-subscribe.
# Exactly ONE inbound consumer (the bus) or replies double up.
UPSTREAM_URL=
BUS_URL=http://localhost:4010

# messaging transports: bluebubbles wins, then ambimail, then sim
BLUEBUBBLES_URL=
BLUEBUBBLES_PASSWORD=
CARRIER_GATEWAY=vtext.com
# GATEWAY_MAP=number:domain[+domain...] -- per-recipient carrier override
# keyed on the 10-digit number; every listed domain is sent, only the
# real carrier delivers. Pin known numbers to one domain:
# GATEWAY_MAP=4253625633:vtext.com,8177136090:txt.att.net
MAIL_POLL_SECONDS=15
MAIL_POLL_LIMIT=20
# inbound that finds no live subscriber is queued and re-fanned on this
# cadence instead of dropped -- covers the bus resubscribe window
FANOUT_RETRY_MS=5000
FANOUT_RETRY_MAX=24
# comma-separated E.164 allowlist for inbound texts; empty accepts all.
# healthz warns when CONTRACT_PHONE is not in the list.
ALLOWED_FROM=
# timeout on outbound fetches: subscriber fanout, ambimail, mailpoller
FETCH_TIMEOUT_MS=8000
# where the undelivered inbound queue persists across restarts
UNDELIVERED_FILE=/tmp/etai-undelivered.json

# bus service
STATE_FILE=
REMINDER_LEAD_MINUTES=30
# CALENDAR=memory forces the in-memory calendar even with an Ambiguous key
CALENDAR=
# mirror sync: batch-push local writes, batch-pull remote events
CALENDAR_SYNC_MS=30000
CALENDAR_SYNC_DAYS=45
# intent classification gives up and falls back to keywords after this
AI_CLASSIFY_TIMEOUT_MS=15000
# CONTRACT_PHONE is canonical; CONTRACTOR_PHONE is a fallback alias
CONTRACTOR_PHONE=
# cap on one queued turn (inbound text or /voice/turn) before the
# caller gets the "recorded shortly" reply
TURN_TIMEOUT_MS=30000
# delay before the "On it" ack text while a turn is still working
WORKING_BEAT_MS=1500
# timeout on the bus -> messaging /send call, and the wait before its
# single retry
SEND_TIMEOUT_MS=10000
SEND_RETRY_MS=800
# msedge-tts voice for /tts when that optional dep is installed
TTS_VOICE=en-US-EmmaNeural

# calendar-agent notify poller
POLL_MS=60000
REMINDER_WINDOW_HOURS=24
# how many days out the calendar-agent summary window covers
AMBIGUOUS_DAYS=7

# each service reads PORT for its listen port (messaging 4020, bus 4010)
PORT=

# frontend keys live in frontend/.env.local:
#   VITE_AMBIGUOUS_API_KEY  roster/calendar/tasks direct to Ambiguous
#   VITE_MESSAGING_URL      dispatcher board texts via messaging /send
#   VITE_BUS_URL            call turns via bus POST /voice/turn
#   VITE_DEMO_PHONE         reroutes every outbound text to the demo number
