AMBIG_API=<key>
AMBIGUOUS_API_KEY=<key>
COPILOT_API=<key>
AMBIGUOUS_BASE_URL=https://app.ambiguous.ai
AMBIG_WEBHOOK_SECRET=<secret>

# phone numbers, E.164
CONTRACT_PHONE=<e.g. +15551234567>
CLIENT_PHONE=<E.164>
CONTRACTOR_TZ=America/Los_Angeles

# wiring -- without BOTH of these the bus never receives texts:
# it self-subscribes PUBLIC_URL/webhooks/inbound at MESSAGING_URL.
MESSAGING_URL=http://localhost:4020
PUBLIC_URL=http://localhost:4010
# messaging: seed a subscriber instead of relying on self-subscribe.
# Exactly ONE inbound consumer (the bus) or replies double up.
UPSTREAM_URL=
BUS_URL=http://localhost:4010

# messaging transports: bluebubbles wins, then ambimail, then sim
BLUEBUBBLES_URL=
BLUEBUBBLES_PASSWORD=
CARRIER_GATEWAY=vtext.com
# GATEWAY_MAP=number:domain[+domain...] -- per-recipient carrier override;
# blast all listed domains, only the real carrier delivers
MAIL_POLL_SECONDS=15
MAIL_POLL_LIMIT=20

# bus service
STATE_FILE=
REMINDER_LEAD_MINUTES=30

# calendar-agent notify poller
POLL_MS=60000
REMINDER_WINDOW_HOURS=24

# frontend keys live in frontend/.env.local:
#   VITE_AMBIGUOUS_API_KEY  roster/calendar/tasks direct to Ambiguous
#   VITE_MESSAGING_URL      dispatcher board texts via messaging /send
