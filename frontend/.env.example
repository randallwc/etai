# Ambiguous.ai API key - get one at https://app.ambiguous.ai/admin
# Without it the board shows no calendar jobs and transcripts no-op.
VITE_AMBIGUOUS_API_KEY=ak_your_key_here

# Service base - call turns go to POST /voice/turn here and the board
# reads GET /state. Without it the agent says it cannot reach the
# service.
VITE_BUS_URL=http://localhost:4020

# Same service base - the dispatcher board sends client texts through
# POST /send here. Without it the board's SMS button no-ops.
VITE_MESSAGING_URL=http://localhost:4020

# Demo number - every outbound text is rerouted here so demos never
# hit a real customer. Unset it to text the customer's actual phone.
VITE_DEMO_PHONE=+15550100100
