# Ambiguous.ai API key — get one at https://app.ambiguous.ai/admin
# Without this the app runs offline with local fallback personas.
VITE_AMBIGUOUS_API_KEY=ak_your_key_here

# Messaging service base — the dispatcher board sends client texts
# through POST /send here. Without it the board's SMS button no-ops.
VITE_MESSAGING_URL=http://localhost:4020
