# Ambiguous.ai API key - get one at https://app.ambiguous.ai/admin
# Without it the transcript handoff on hangup no-ops.
VITE_AMBIGUOUS_API_KEY=ak_your_key_here

# Service base - call turns go to POST /voice/turn here. Without it
# the agent says it cannot reach the service.
VITE_BUS_URL=http://localhost:4020

# The caller identity sent on every turn - point it at the number
# the service should treat as the customer.
VITE_DEMO_PHONE=+15550100100
