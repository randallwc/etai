{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etai/models/demo-deck",
  "title": "ETAi Demo Deck",
  "description": "Content contract for the standalone hackathon demo presentation. Owner: ETAi hackathon team. This schema belongs under models because the demo folder holds a browser-delivered presentation, not application data.",
  "type": "object",
  "required": ["title", "slides"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "purpose"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "speakerNotes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
