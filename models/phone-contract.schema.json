{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etai/models/phone-contract",
  "title": "Phone Service Contract",
  "description": "Wire shapes for the phone service boundary defined in docs/PHONE.md. Inbound messages are POSTed by the phone service to POST {AGENT_BASE_URL}/webhooks/inbound; outbound sends are POSTed by the agent to {PHONE_SERVICE_URL}/send; voice tool calls are answered synchronously on /webhooks/voice-toolcall.",
  "$defs": {
    "e164": {
      "type": "string",
      "pattern": "^\\+[1-9]\\d{6,14}$"
    },
    "isoTimestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 with an explicit offset"
    },
    "inboundMessage": {
      "type": "object",
      "required": ["channel", "from", "body", "externalId", "receivedAt", "threadKey"],
      "properties": {
        "channel": { "enum": ["imessage", "sms", "voice", "console"] },
        "from": { "$ref": "#/$defs/e164" },
        "body": { "type": "string", "minLength": 1 },
        "externalId": { "type": "string", "minLength": 1, "description": "provider-unique id used for dedup" },
        "receivedAt": { "$ref": "#/$defs/isoTimestamp" },
        "threadKey": { "type": "string", "minLength": 1 },
        "meta": { "type": "object", "description": "transport detail for debugging only" }
      },
      "additionalProperties": false
    },
    "sendRequest": {
      "type": "object",
      "required": ["to", "body"],
      "properties": {
        "to": { "$ref": "#/$defs/e164" },
        "body": { "type": "string", "minLength": 1 },
        "threadKey": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "sendResponse": {
      "type": "object",
      "required": ["externalId"],
      "properties": {
        "externalId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "voiceToolCall": {
      "type": "object",
      "required": ["callId", "tool", "args"],
      "properties": {
        "callId": { "type": "string", "minLength": 1 },
        "tool": { "type": "string", "minLength": 1 },
        "args": { "type": "object" }
      },
      "additionalProperties": false
    },
    "voiceToolResult": {
      "type": "object",
      "required": ["result"],
      "properties": {
        "result": true
      },
      "additionalProperties": false
    }
  }
}
