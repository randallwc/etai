{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CalendarEvent",
  "description": "Item in the `data` array of GET /api/calendars/events, and the response of POST /api/calendars/:calendar_id/events. Times are UTC ISO-8601. Verified against the live API 2026-09-12.",
  "type": "object",
  "required": ["id", "title", "start_at", "end_at"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "calendar_id": { "type": "string", "format": "uuid" },
    "title": { "type": "string" },
    "start_at": { "type": "string", "format": "date-time" },
    "end_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string" },
    "attendees": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": { "type": "string" },
          "display_name": { "type": ["string", "null"] },
          "kind": { "type": "string" },
          "rsvp": { "type": "string" }
        }
      }
    }
  }
}
