{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task",
  "description": "Wrapped in a `task` key: POST /api/tasks returns {task: Task}. GET /api/tasks returns {data: Task[]}. Verified against the live API 2026-09-12.",
  "type": "object",
  "required": ["id", "task_key", "title", "status"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "task_key": { "type": "string" },
    "title": { "type": "string" },
    "status": { "type": "string", "enum": ["todo", "in_progress", "done", "cancelled", "blocked"] },
    "priority": { "type": "string" },
    "due_date": { "type": ["string", "null"] },
    "assignee_id": { "type": ["string", "null"] }
  }
}
