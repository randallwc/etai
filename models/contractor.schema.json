{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contractor",
  "description": "The pro who owns the schedule. One per workspace for the hackathon. Defined by the data model in docs/API.md.",
  "type": "object",
  "required": ["id", "name", "phone", "ambiguousUserId"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "trade": { "type": "string", "description": "e.g. gardener, plumber, cleaner" },
    "phone": { "type": "string", "pattern": "^\\+[1-9]\\d{6,14}$" },
    "ambiguousUserId": { "type": "string", "minLength": 1, "description": "workspace member id; availability is member-centric" },
    "workingHours": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "pattern": "^\\d{2}:\\d{2}$", "description": "local HH:MM" },
        "end": { "type": "string", "pattern": "^\\d{2}:\\d{2}$", "description": "local HH:MM" },
        "timezone": { "type": "string", "description": "IANA name, e.g. America/Los_Angeles" }
      },
      "additionalProperties": false
    },
    "homeBaseAddress": { "type": "string", "description": "start/end anchor for travel-time math" }
  },
  "additionalProperties": false
}
