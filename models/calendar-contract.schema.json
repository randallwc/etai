{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etai/models/calendar-contract",
  "title": "Calendar Service Contract",
  "description": "Wire shapes for the calendar service boundary defined in docs/CALENDAR.md. The calendar service wraps the Ambiguous workspace; the live implementation currently resolves these operations through Ambiguous Assistant chat (see docs/calendar-agent.md).",
  "$defs": {
    "e164": {
      "type": "string",
      "pattern": "^\\+[1-9]\\d{6,14}$"
    },
    "isoTimestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 with an explicit offset"
    },
    "localDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "eventStatus": {
      "enum": ["confirmed", "en_route", "done", "canceled"]
    },
    "timeWindow": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/isoTimestamp" },
        "end": { "$ref": "#/$defs/isoTimestamp" }
      },
      "additionalProperties": false
    },
    "calendarEvent": {
      "type": "object",
      "required": ["id", "start", "end", "title", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "start": { "$ref": "#/$defs/isoTimestamp" },
        "end": { "$ref": "#/$defs/isoTimestamp" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "address": { "type": "string" },
        "status": { "$ref": "#/$defs/eventStatus" }
      },
      "additionalProperties": false
    },
    "availabilityRequest": {
      "type": "object",
      "required": ["date", "durationMinutes"],
      "properties": {
        "date": { "$ref": "#/$defs/localDate" },
        "durationMinutes": { "type": "integer", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "availabilityResponse": {
      "type": "object",
      "required": ["windows"],
      "properties": {
        "windows": { "type": "array", "items": { "$ref": "#/$defs/timeWindow" } }
      },
      "additionalProperties": false
    },
    "listEventsResponse": {
      "type": "object",
      "required": ["events"],
      "properties": {
        "events": { "type": "array", "items": { "$ref": "#/$defs/calendarEvent" } }
      },
      "additionalProperties": false
    },
    "createEventRequest": {
      "type": "object",
      "required": ["title", "start", "end", "description", "address", "customerName", "customerPhone"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "start": { "$ref": "#/$defs/isoTimestamp" },
        "end": { "$ref": "#/$defs/isoTimestamp" },
        "description": { "type": "string" },
        "address": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "$ref": "#/$defs/e164" }
      },
      "additionalProperties": false
    },
    "updateEventRequest": {
      "type": "object",
      "properties": {
        "start": { "$ref": "#/$defs/isoTimestamp" },
        "end": { "$ref": "#/$defs/isoTimestamp" },
        "description": { "type": "string" },
        "status": { "$ref": "#/$defs/eventStatus" }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "cancelEventRequest": {
      "type": "object",
      "properties": {
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "calendarErrorCode": {
      "enum": ["conflict", "not_found", "invalid", "upstream", "auth"]
    },
    "apiError": {
      "type": "object",
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "$ref": "#/$defs/calendarErrorCode" },
            "message": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
